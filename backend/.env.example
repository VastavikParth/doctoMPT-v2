# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-flash-live
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Neo4j Database Configuration
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=doctompt_secret_password
NEO4J_DATABASE=neo4j

# Vector Search Configuration
NEO4J_VECTOR_INDEX_NAME=medicine_embeddings
NEO4J_NODE_LABEL=Medicine
NEO4J_TEXT_PROPERTY=details
NEO4J_EMBEDDING_PROPERTY=embedding

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","https://docto-mpt.vercel.app"]
